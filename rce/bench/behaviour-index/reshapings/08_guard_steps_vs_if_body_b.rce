state Door
    open: bool = false
    locked: bool = false

event Open
event Close
event Lock
event Unlock

error DoorOpen
error Locked

step Door on Open
    if locked
        fail Locked
    open = true
step Door on Close
    open = false
step Door on Lock
    if open
        fail DoorOpen
    locked = true
step Door on Unlock
    locked = false
