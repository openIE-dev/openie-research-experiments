# Counting words one character at a time, as a small lexer would.
intent "count words in a stream of bytes"
    example Char(c: 104), Char(c: 105), Char(c: 32), Char(c: 121), Char(c: 111) -> words == 2
    example Char(c: 32), Char(c: 32) -> words == 0

kind Mode
    Start
    Word
    Space

state Lexer
    tblpos: u64 = 0
    mode: Mode = Start
    words: i64 = 0

event Char(c: u8)

step Lexer on Char(c: ch) if tblpos == 0 or tblpos == 1 or tblpos == 2 or tblpos == 3 or tblpos == 4
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    elif tblpos == 2
        tblpos = 3
    elif tblpos == 3
        tblpos = 4
    elif tblpos == 4
        tblpos = 5
    if ch == 32
        mode = Space
    else
        match mode
            Word -> pass
            _ -> words += 1
        mode = Word
step Lexer on Char(c: _) if tblpos == 0 or tblpos == 1 or tblpos == 2 or tblpos == 3 or tblpos == 4
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    elif tblpos == 2
        tblpos = 3
    elif tblpos == 3
        tblpos = 4
    elif tblpos == 4
        tblpos = 5
step Lexer on Char(c: _)
    fail TblOff

error TblOff
