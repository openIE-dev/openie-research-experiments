module echo

intent "an effect request is an emitted struct with a req id; the host answers each with exactly one EchoDone"
    example Say(msg: "hi"), EchoDone(req: 1, status: "failed", data: none, err: "x") -> failed == 1

struct Echo
    req: u64
    msg: text

event Say(msg: text)
event EchoDone(req: u64, status: text, data: text?, err: text)

state S
    tblpos: u64 = 0
    next: u64 = 0
    got: List[text] = []
    failed: u64 = 0

step S on Say(msg: m) if tblpos == 0
    if tblpos == 0
        tblpos = 1
    next += 1
    emit Echo(req: next, msg: m)
step S on Say(msg: _) if tblpos == 0
    if tblpos == 0
        tblpos = 1
step S on Say(msg: _)
    fail TblOff

step S on EchoDone(req: _r, status: st, data: d, err: _e) if tblpos == 1
    if tblpos == 1
        tblpos = 2
    if st == "delivered"
        got.push(d.or(""))
    else
        failed += 1
step S on EchoDone(req: _, status: _, data: _, err: _) if tblpos == 1
    if tblpos == 1
        tblpos = 2
step S on EchoDone(req: _, status: _, data: _, err: _)
    fail TblOff

error TblOff
