module rcedb

intent "a keyed store written in RCE over the host's durable append (Appendix E.8): puts are state writes, a bound Synced event moves the durable mark, scans are in canonical key order"
    example Put(key: "b", val: "2"), Put(key: "a", val: "1"), Synced(upto: 1) -> durable == 1
    example Put(key: "k", val: "v"), Delete(key: "k") -> rows.len() == 0
    example Delete(key: "x") -> kept: Missing

state Db
    tblpos: u64 = 0
    rows: Map[text, text] = {}
    writes: u64 = 0
    durable: u64 = 0

event Put(key: text, val: text)
event Delete(key: text)
event Synced(upto: u64)
event Scan(start: text)

error Missing(key: text)

struct Row
    key: text
    val: text

step Db on Put(key: k, val: v) if tblpos == 0 or tblpos == 1
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    rows[k] = v
    writes += 1
step Db on Put(key: _, val: _) if tblpos == 0 or tblpos == 1
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
step Db on Put(key: _, val: _)
    fail TblOff
step Db on Delete(key: k) if tblpos == 1 or tblpos == 0
    if tblpos == 1
        tblpos = 4
    elif tblpos == 0
        tblpos = 5
    if not rows.contains(k)
        fail Missing(key: k)
    let _ = rows.remove(k)
    writes += 1
step Db on Delete(key: _) if tblpos == 1 or tblpos == 0
    if tblpos == 1
        tblpos = 4
    elif tblpos == 0
        tblpos = 5
step Db on Delete(key: _)
    fail TblOff
step Db on Synced(upto: n) if tblpos == 2
    if tblpos == 2
        tblpos = 3
    if n > durable
        durable = n
step Db on Synced(upto: _) if tblpos == 2
    if tblpos == 2
        tblpos = 3
step Db on Synced(upto: _)
    fail TblOff
step Db on Scan(start: f) if tblpos == tblpos + 1
    var ks = rows.keys()
    ks.sort()
    for k in ks
        if k >= f
            let v = rows.get(k) catch ""
            emit Row(key: k.tostr(), val: v)
step Db on Scan(start: _)
    fail TblOff

error TblOff
