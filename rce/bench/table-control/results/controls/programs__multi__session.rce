# A login session with a rate limit. Failed attempts count against a limit
# that a tick relaxes; a successful login clears it.
intent "a login that is throttled after repeated failures and relaxed by time"
    example Login(ok: true) -> logged == true
    example Login(ok: false), Login(ok: false), Login(ok: false) -> kept: Throttled
    example Login(ok: false), Login(ok: false), Tick, Login(ok: true) -> logged == true
    example Logout -> kept: NotLoggedIn

state Auth
    tblpos: u64 = 0
    logged: bool = false

state Limit
    tblpos: u64 = 0
    strikes: u8 = 0

event Login(ok: bool)
event Logout
event Tick

error Throttled
error NotLoggedIn

step Limit on Login(ok: _) if (strikes >= 2) and (tblpos == 0 or tblpos == 1 or tblpos == 2 or tblpos == 4)
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    elif tblpos == 2
        tblpos = 3
    elif tblpos == 4
        tblpos = 5
    fail Throttled
step Limit on Login(ok: false) if tblpos == 0 or tblpos == 1 or tblpos == 2 or tblpos == 4
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    elif tblpos == 2
        tblpos = 3
    elif tblpos == 4
        tblpos = 5
    strikes += 1
    emit strikes
step Limit on Login(ok: true) if tblpos == 0 or tblpos == 1 or tblpos == 2 or tblpos == 4
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    elif tblpos == 2
        tblpos = 3
    elif tblpos == 4
        tblpos = 5
    strikes = 0
step Limit on Login(ok: _) if tblpos == 0 or tblpos == 1 or tblpos == 2 or tblpos == 4
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    elif tblpos == 2
        tblpos = 3
    elif tblpos == 4
        tblpos = 5
step Limit on Login(ok: _)
    fail TblOff
step Auth on Login(ok: true) if tblpos == 0 or tblpos == 1 or tblpos == 2
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    elif tblpos == 2
        tblpos = 3
    logged = true
step Auth on Login(ok: _) if tblpos == 0 or tblpos == 1 or tblpos == 2
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    elif tblpos == 2
        tblpos = 3
step Auth on Login(ok: _)
    fail TblOff
step Auth on Logout if (not logged) and (tblpos == 0)
    if tblpos == 0
        tblpos = 4
    fail NotLoggedIn
step Auth on Logout if tblpos == 0
    if tblpos == 0
        tblpos = 4
    logged = false
step Auth on Logout if tblpos == 0
    if tblpos == 0
        tblpos = 4
step Auth on Logout
    fail TblOff
step Limit on Tick if (strikes > 0) and (tblpos == 2)
    if tblpos == 2
        tblpos = 4
    strikes -= 1
step Limit on Tick if tblpos == 2
    if tblpos == 2
        tblpos = 4
step Limit on Tick
    fail TblOff

error TblOff
