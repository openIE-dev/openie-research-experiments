module floatvec

# Cross-target float vectors (6.3 N3). Every target must reproduce these bits:
# the trace hashes each state, so one differing bit changes the parity hash.
# Non-finite results (overflow, x / 0.0, sqrt of a negative) trap; examples
# cannot state a trap, so tests/float_rules.rs holds those vectors.
intent "IEEE 754 binary64 vectors that every target computes bit for bit"
    example MulSub(a: 0.1, b: 10.0, c: 1.0) -> x == (0.0)
    example Add(a: 0.1, b: 0.2) -> x == (0.30000000000000004)
    example Div(a: 1.0, b: 3.0) -> x == (0.3333333333333333)
    example Sqrt(a: 2.0) -> x == (1.4142135623730951)
    example Mul(a: 5e-324, b: 0.5) -> x == (0.0)
    example Mul(a: 0.0, b: -1.0) -> x == (-0.0)
    example Mul(a: 5e-324, b: 3.0) -> x == (1.5e-323)
    example Div(a: 2.2250738585072014e-308, b: 4503599627370496.0) -> x == (5e-324)
    example Mul(a: 2.2250738585072014e-308, b: 0.5) -> x == (1.1125369292536007e-308)
    example Add(a: 1e16, b: 1.0) -> x == (10000000000000000.0)
    example Add(a: 1e16, b: 3.0) -> x == (10000000000000004.0)
    example Round(a: 2.5) -> x == (3.0)
    example Round(a: -2.5) -> x == (-3.0)
    example Conv(n: 9007199254740993) -> x == (9007199254740992.0)
    example F32Mul(a: 0.1, b: 3.0) -> x == (0.30000001192092896)
    example Add(a: 1.7976931348623157e308, b: 1e291) -> x == (1.7976931348623157e308)

state Lab
    tblpos: u64 = 0
    x: f64 = 0.0

event MulSub(a: f64, b: f64, c: f64)
event Add(a: f64, b: f64)
event Mul(a: f64, b: f64)
event Div(a: f64, b: f64)
event Sqrt(a: f64)
event Round(a: f64)
event Conv(n: i64)
event F32Mul(a: f64, b: f64)

# a * b - c is two roundings (no contraction): 0.1 * 10.0 rounds to 1.0, so
# the result is 0; a fused multiply-add would give 5.551115123125783e-17.
step Lab on MulSub(a: a, b: b, c: c) if tblpos == 0
    if tblpos == 0
        tblpos = 1
    x = a * b - c
step Lab on MulSub(a: _, b: _, c: _) if tblpos == 0
    if tblpos == 0
        tblpos = 1
step Lab on MulSub(a: _, b: _, c: _)
    fail TblOff
step Lab on Add(a: a, b: b) if tblpos == 0
    if tblpos == 0
        tblpos = 2
    x = a + b
step Lab on Add(a: _, b: _) if tblpos == 0
    if tblpos == 0
        tblpos = 2
step Lab on Add(a: _, b: _)
    fail TblOff
step Lab on Mul(a: a, b: b) if tblpos == 0
    if tblpos == 0
        tblpos = 5
    x = a * b
step Lab on Mul(a: _, b: _) if tblpos == 0
    if tblpos == 0
        tblpos = 5
step Lab on Mul(a: _, b: _)
    fail TblOff
step Lab on Div(a: a, b: b) if tblpos == 0
    if tblpos == 0
        tblpos = 3
    x = a / b
step Lab on Div(a: _, b: _) if tblpos == 0
    if tblpos == 0
        tblpos = 3
step Lab on Div(a: _, b: _)
    fail TblOff
step Lab on Sqrt(a: a) if tblpos == 0
    if tblpos == 0
        tblpos = 4
    x = a.sqrt()
step Lab on Sqrt(a: _) if tblpos == 0
    if tblpos == 0
        tblpos = 4
step Lab on Sqrt(a: _)
    fail TblOff
step Lab on Round(a: a) if tblpos == 0
    if tblpos == 0
        tblpos = 6
    x = a.round()
step Lab on Round(a: _) if tblpos == 0
    if tblpos == 0
        tblpos = 6
step Lab on Round(a: _)
    fail TblOff
step Lab on Conv(n: n) if tblpos == 0
    if tblpos == 0
        tblpos = 7
    x = n as f64
step Lab on Conv(n: _) if tblpos == 0
    if tblpos == 0
        tblpos = 7
step Lab on Conv(n: _)
    fail TblOff
step Lab on F32Mul(a: a, b: b) if tblpos == 0
    if tblpos == 0
        tblpos = 8
    x = ((a as f32) * (b as f32)) as f64
step Lab on F32Mul(a: _, b: _) if tblpos == 0
    if tblpos == 0
        tblpos = 8
step Lab on F32Mul(a: _, b: _)
    fail TblOff

error TblOff
