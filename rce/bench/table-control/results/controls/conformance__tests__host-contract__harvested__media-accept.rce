module media

intent "media capture and playback: each Tick reads one frame from the open track; D logs only (track, seq, digest) and the frame's Tick, the frame bytes stay a blob addressed by digest; every captured frame is played back to the sink by digest"
    example Open(source: "pattern:2"), MediaOpenDone(req: 1, status: "delivered", data: some(1), err: "") -> track == 1

struct MediaOpen
    req: u64
    source: text

struct MediaRead
    req: u64
    id: u64

struct MediaPlay
    req: u64
    track: text
    digest: text

event Open(source: text)
event Tick(n: u64)
event MediaOpenDone(req: u64, status: text, data: u64?, err: text)
event MediaReadDone(req: u64, status: text, data: text?, err: text)
event MediaPlayDone(req: u64, status: text, data: u64?, err: text)

state Call
    tblpos: u64 = 0
    next: u64 = 0
    track: u64 = 0
    tick: u64 = 0
    ended: bool = false
    frames: List[text] = []
    played: u64 = 0
    bytes: u64 = 0
    errors: u64 = 0

step Call on Open(source: s) if tblpos == 0
    if tblpos == 0
        tblpos = 1
    next += 1
    emit MediaOpen(req: next, source: s)
step Call on Open(source: _) if tblpos == 0
    if tblpos == 0
        tblpos = 1
step Call on Open(source: _)
    fail TblOff

step Call on MediaOpenDone(req: _r, status: st, data: d, err: _e) if tblpos == 1
    if tblpos == 1
        tblpos = 2
    if st == "delivered"
        track = d.or(0)
    else
        errors += 1
step Call on MediaOpenDone(req: _, status: _, data: _, err: _) if tblpos == 1
    if tblpos == 1
        tblpos = 2
step Call on MediaOpenDone(req: _, status: _, data: _, err: _)
    fail TblOff

step Call on Tick(n: n) if tblpos == tblpos + 1
    tick = n
    if track > 0 and not ended
        next += 1
        emit MediaRead(req: next, id: track)
step Call on Tick(n: _)
    fail TblOff

# a frame: "track/seq/digest@tick"; the bytes are never in state or D
step Call on MediaReadDone(req: _r, status: st, data: d, err: e) if tblpos == tblpos + 1
    if st == "delivered"
        let f = d.or("").split(":")
        frames.push(track.tostr() + "/" + copy(f[0]) + "/" + copy(f[1]) + "@" + tick.tostr())
        next += 1
        emit MediaPlay(req: next, track: "loopback", digest: copy(f[1]))
    else
        if e == "eof"
            ended = true
        else
            errors += 1
step Call on MediaReadDone(req: _, status: _, data: _, err: _)
    fail TblOff

step Call on MediaPlayDone(req: _r, status: st, data: d, err: _e) if tblpos == tblpos + 1
    if st == "delivered"
        played += 1
        bytes += d.or(0)
    else
        errors += 1
step Call on MediaPlayDone(req: _, status: _, data: _, err: _)
    fail TblOff

error TblOff
