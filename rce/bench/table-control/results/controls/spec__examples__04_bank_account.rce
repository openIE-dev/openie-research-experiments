module bank

intent "a bank account that keeps its balance on an overdraft (Insufficient)"
    example Deposit(amount: 50), Withdraw(amount: 20) -> balance == (30)
    example Withdraw(amount: 1) -> kept: Insufficient

state Account
    tblpos: u64 = 0
    balance: i64 = 0

event Deposit(amount: i64)
event Withdraw(amount: i64)

error Insufficient(need: i64)

struct Withdrawn
    amount: i64

step Account on Deposit(amount: a) if (a > 0) and (tblpos == 0)
    if tblpos == 0
        tblpos = 1
    balance = balance + a
step Account on Deposit(amount: _) if tblpos == 0
    if tblpos == 0
        tblpos = 1
    balance = balance
step Account on Deposit(amount: _) if tblpos == 0
    if tblpos == 0
        tblpos = 1
step Account on Deposit(amount: _)
    fail TblOff
step Account on Withdraw(amount: a) if tblpos == 1 or tblpos == 0
    if tblpos == 1
        tblpos = 2
    elif tblpos == 0
        tblpos = 3
    if a > balance
        fail Insufficient(need: a - balance)
    balance -= a
    emit Withdrawn(amount: a)
step Account on Withdraw(amount: _) if tblpos == 1 or tblpos == 0
    if tblpos == 1
        tblpos = 2
    elif tblpos == 0
        tblpos = 3
step Account on Withdraw(amount: _)
    fail TblOff

error TblOff
