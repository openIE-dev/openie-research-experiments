# An account kept in integer cents. RCE has no decimal type, so money is
# stored in the smallest unit (see change/decimal.rce).
intent "withdrawals never overdraw the account"
    example Deposit(cents: 1000), Withdraw(cents: 250) -> balance_cents == (750)
    example Withdraw(cents: 1) -> kept: Insufficient
    example Deposit(cents: 0) -> kept: NotPositive

state Account
    tblpos: u64 = 0
    balance_cents: i64 = 0

event Deposit(cents: i64)
event Withdraw(cents: i64)

error Insufficient(need: i64)
error NotPositive

step Account on Deposit(cents: a) if (a <= 0) and (tblpos == 0)
    if tblpos == 0
        tblpos = 1
    fail NotPositive
step Account on Deposit(cents: a) if tblpos == 0
    if tblpos == 0
        tblpos = 1
    balance_cents += a
step Account on Deposit(cents: _) if tblpos == 0
    if tblpos == 0
        tblpos = 1
step Account on Deposit(cents: _)
    fail TblOff
step Account on Withdraw(cents: a) if (a <= 0) and (tblpos == 1 or tblpos == 0)
    if tblpos == 1
        tblpos = 2
    elif tblpos == 0
        tblpos = 3
    fail NotPositive
step Account on Withdraw(cents: a) if tblpos == 1 or tblpos == 0
    if tblpos == 1
        tblpos = 2
    elif tblpos == 0
        tblpos = 3
    if a > balance_cents
        fail Insufficient(need: a - balance_cents)
    balance_cents -= a
step Account on Withdraw(cents: _) if tblpos == 1 or tblpos == 0
    if tblpos == 1
        tblpos = 2
    elif tblpos == 0
        tblpos = 3
step Account on Withdraw(cents: _)
    fail TblOff

error TblOff
