intent "a counter mod 6 whose only output is its parity"
    "rce dim (10.11): 6 states explored, 2 behaviours, redundancy 1.58 bits: the state carries a period of 6 but the behaviour has a period of 2"
    example DimStep -> n == 1
    example DimStep, DimStep, DimStep, DimStep, DimStep, DimStep -> n == 0

state DimPhase
    tblpos: u64 = 0
    n: u64 = 0

event DimStep

step DimPhase on DimStep if tblpos == 0 or tblpos == 1 or tblpos == 2 or tblpos == 3 or tblpos == 4 or tblpos == 5
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    elif tblpos == 2
        tblpos = 3
    elif tblpos == 3
        tblpos = 4
    elif tblpos == 4
        tblpos = 5
    elif tblpos == 5
        tblpos = 6
    n = (n + 1) % 6
    emit n % 2
step DimPhase on DimStep if tblpos == 0 or tblpos == 1 or tblpos == 2 or tblpos == 3 or tblpos == 4 or tblpos == 5
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    elif tblpos == 2
        tblpos = 3
    elif tblpos == 3
        tblpos = 4
    elif tblpos == 4
        tblpos = 5
    elif tblpos == 5
        tblpos = 6
step DimPhase on DimStep
    fail TblOff

error TblOff
