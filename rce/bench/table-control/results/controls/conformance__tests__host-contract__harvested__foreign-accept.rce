module foreign

intent "a foreign call is an effect: its result or trap is logged and replayed, never re-run"
    example Call(code: "m", func: "f", args: [1]), WasmCallDone(req: 1, status: "failed", data: none, err: "trap") -> traps == 1

struct WasmCall
    req: u64
    code: text
    func: text
    args: List[i64]

event Call(code: text, func: text, args: List[i64])
event WasmCallDone(req: u64, status: text, data: List[i64]?, err: text)

state F
    tblpos: u64 = 0
    next: u64 = 0
    results: List[i64] = []
    traps: u64 = 0

step F on Call(code: m, func: f, args: a) if tblpos == 0
    if tblpos == 0
        tblpos = 1
    next += 1
    emit WasmCall(req: next, code: m, func: f, args: a)
step F on Call(code: _, func: _, args: _) if tblpos == 0
    if tblpos == 0
        tblpos = 1
step F on Call(code: _, func: _, args: _)
    fail TblOff

step F on WasmCallDone(req: _r, status: s, data: d, err: _e) if tblpos == 1
    if tblpos == 1
        tblpos = 2
    if s == "delivered"
        for x in d.or([])
            results.push(x)
    else
        traps += 1
step F on WasmCallDone(req: _, status: _, data: _, err: _) if tblpos == 1
    if tblpos == 1
        tblpos = 2
step F on WasmCallDone(req: _, status: _, data: _, err: _)
    fail TblOff

error TblOff
