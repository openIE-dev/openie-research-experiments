# A one-joint arm moved by a proportional controller. Each sensor reading
# moves the commanded angle halfway towards the target.
intent "a proportional controller that keeps its state on an impossible reading"
    example Sensor(reading: 0.0) -> angle == 0.5
    example Sensor(reading: 0.0), Sensor(reading: 0.5) -> angle == 0.75
    example Sensor(reading: 7.0) -> kept: OutOfRange

state Arm
    tblpos: u64 = 0
    angle: f64 = 0.0
    target: f64 = 1.0

event Sensor(reading: f64)
error OutOfRange

step Arm on Sensor(reading: r) if (r < -3.2 or r > 3.2) and (tblpos == 0 or tblpos == 1)
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    fail OutOfRange
step Arm on Sensor(reading: r) if tblpos == 0 or tblpos == 1
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
    angle += 0.5 * (target - r)
step Arm on Sensor(reading: _) if tblpos == 0 or tblpos == 1
    if tblpos == 0
        tblpos = 1
    elif tblpos == 1
        tblpos = 2
step Arm on Sensor(reading: _)
    fail TblOff

error TblOff
