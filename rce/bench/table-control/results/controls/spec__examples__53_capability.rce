# rce-version: 0.8
module admin

intent "authority is a value (5.16): a Guarded field is written only by a step whose event carries the capability"
    example SetLimit(admin: (), limit: 50) -> limit == 50
    example SetLimit(admin: (), limit: 50), Spend(amount: 20) -> spent == 20
    example Spend(amount: 5) -> limit == 100

struct Root

state Policy
    tblpos: u64 = 0
    limit: Guarded[u32, Root] = 100

state Ledger
    tblpos: u64 = 0
    spent: u32 = 0

event SetLimit(admin: Cap[Root], limit: u32)
event Spend(amount: u32)

step Policy on SetLimit(admin: _, limit: n) if tblpos == 0
    if tblpos == 0
        tblpos = 1
    limit = n
step Policy on SetLimit(admin: _, limit: _) if tblpos == 0
    if tblpos == 0
        tblpos = 1
step Policy on SetLimit(admin: _, limit: _)
    fail TblOff
step Ledger on Spend(amount: a) if tblpos == 0
    if tblpos == 0
        tblpos = 1
    spent = spent + a
step Ledger on Spend(amount: _) if tblpos == 0
    if tblpos == 0
        tblpos = 1
step Ledger on Spend(amount: _)
    fail TblOff

error TblOff
