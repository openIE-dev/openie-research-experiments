module remote_channels

intent "remote channels: sends have one logged outcome, receives are logged inputs, duplicates are dropped by id"
    example Send(peer: "p", body: "x"), ChanSendDone(req: 1, status: "unreachable", data: none, err: "x") -> lost == 1

struct ChanSend
    req: u64
    peer: text
    id: u64
    body: text
    reliable: bool

struct ChanRecv
    req: u64
    max: u64

event Send(peer: text, body: text)
event Ping(peer: text)
event Poll
event ChanSendDone(req: u64, status: text, data: u64?, err: text)
event ChanRecvDone(req: u64, status: text, data: List[text]?, err: text)

state C
    tblpos: u64 = 0
    next: u64 = 0
    sent: u64 = 0
    lost: u64 = 0
    inbox: List[text] = []

step C on Send(peer: p, body: b) if tblpos == 0
    if tblpos == 0
        tblpos = 1
    next += 1
    emit ChanSend(req: next, peer: p, id: next, body: b, reliable: true)
step C on Send(peer: _, body: _) if tblpos == 0
    if tblpos == 0
        tblpos = 1
step C on Send(peer: _, body: _)
    fail TblOff

step C on Ping(peer: p) if tblpos == tblpos + 1
    next += 1
    emit ChanSend(req: next, peer: p, id: next, body: "typing", reliable: false)
step C on Ping(peer: _)
    fail TblOff

step C on Poll if tblpos == tblpos + 1
    next += 1
    emit ChanRecv(req: next, max: 64)
step C on Poll
    fail TblOff

step C on ChanSendDone(req: _r, status: s, data: _d, err: _e) if tblpos == 1
    if tblpos == 1
        tblpos = 2
    if s == "delivered"
        sent += 1
    else
        lost += 1
step C on ChanSendDone(req: _, status: _, data: _, err: _) if tblpos == 1
    if tblpos == 1
        tblpos = 2
step C on ChanSendDone(req: _, status: _, data: _, err: _)
    fail TblOff

step C on ChanRecvDone(req: _r, status: _s, data: d, err: _e) if tblpos == tblpos + 1
    for m in d.or([])
        inbox.push(m)
step C on ChanRecvDone(req: _, status: _, data: _, err: _)
    fail TblOff

error TblOff
