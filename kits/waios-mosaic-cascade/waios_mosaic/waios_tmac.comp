#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer WeightsBuf {
    int weights_i32[];
};
layout(std430, set = 0, binding = 1) readonly buffer ActsBuf {
    int acts_i32[];
};
layout(std430, set = 0, binding = 2) writeonly buffer OutBuf {
    int out_i32[];
};

layout(push_constant) uniform PushConsts {
    int row_start;
    int row_end;
    int cols;
} pc;

void main() {
    int r = pc.row_start + int(gl_GlobalInvocationID.x);
    if (r >= pc.row_end) {
        return;
    }
    int acc = 0;
    int base = r * pc.cols;
    for (int c = 0; c < pc.cols; c++) {
        int w = weights_i32[base + c];
        int a = acts_i32[c];
        if (w == 1) {
            acc += a;
        } else if (w == -1) {
            acc -= a;
        }
    }
    out_i32[r] = acc;
}
